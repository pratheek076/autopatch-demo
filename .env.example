# === LLM Backend (pick one) ===
GOOGLE_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_key_here

# === Jenkins Integration ===
JENKINS_URL=http://localhost:9090
JENKINS_USER=admin
JENKINS_API_TOKEN=your_jenkins_api_token_here    # Jenkins → User → Configure → API Token
JENKINS_JOB_NAME=autopatch-sample               # The job AutoPatch monitors
JENKINS_WEBHOOK_TOKEN=your_secret_token_here    # Shared secret between Jenkins and AutoPatch

# === GitHub Integration (for opening PRs on the patched branch) ===
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=your_target_repo

# === Redis (task queue / agent state) ===
REDIS_URL=redis://localhost:6379/0

# === OPA Policy Engine ===
OPA_URL=http://localhost:8181

# === Agent Behavior ===
PATCH_AGENT_MAX_LINES=150
DIAGNOSIS_CONFIDENCE_THRESHOLD=0.8
AUTO_MERGE_ENABLED=false       # Safety: keep false until well-tested

# === AutoPatch webhook URL (set this in Jenkins environment) ===
AUTOPATCH_WEBHOOK_URL=http://host.docker.internal:8000   # Use this when Jenkins is in Docker
AUTOPATCH_WEBHOOK_TOKEN=your_secret_token_here           # Same as JENKINS_WEBHOOK_TOKEN
